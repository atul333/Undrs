# ─────────────────────────────────────────────────────────────────────────────
#  UNDRESS BOT — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram Bot ──────────────────────────────────────────────────────────────
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# ── Your Own API Server ───────────────────────────────────────────────────────
# Generate a key with: python manage_keys.py create --label "BotKey" --credits 1000
OWN_API_KEY=udt_your_generated_key_here
OWN_API_URL=http://localhost:8000

# ── Webhook (bot's embedded HTTP server that receives results) ─────────────────
# If api_server.py and undress_bot.py run on the SAME machine, keep localhost.
# If they are on different machines, set this to the bot machine's public URL.
WEBHOOK_BASE_URL=http://localhost:8888
WEBHOOK_PORT=8888

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Secret header required to access /admin/* routes
ADMIN_SECRET=change-this-to-a-strong-random-secret
# Default credits for newly created API keys
DEFAULT_CREDITS=100

# ── Database paths ────────────────────────────────────────────────────────────
BOT_DB_PATH=undress_jobs.db
API_DB_PATH=api_server.db
